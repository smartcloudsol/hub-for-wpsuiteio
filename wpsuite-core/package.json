{
  "name": "@smart-cloud/wpsuite-core",
  "version": "2.4.0",
  "description": "WP Suite Core package",
  "author": "Smart Cloud Solutions Inc.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "tsup --minify",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint 'src/**/*.ts' --report-unused-disable-directives --max-warnings 0",
    "test": "node --test tests/*.test.ts",
    "release:npm": "WPSUITE_PREMIUM=true yarn build && npm publish --access=public",
    "build:locale-browser": "esbuild src/locale-browser.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=../../wpsuite-theme/assets/js/site-locale.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "resolutions": {
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1"
  },
  "sideEffects": false,
  "dependencies": {
    "tldts": "^7.4.12"
  },
  "peerDependencies": {
    "@wordpress/data": "^10.54.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@wordpress/data": "^10.54.0",
    "eslint": "^10.10.0",
    "jose": "^6.2.12",
    "globals": "^17.12.0",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "react-dom": "18.3.1"
  }
}
