{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wpsuite/react-fallback",
  "version": "1.0.0",
  "title": "React Fallback",
  "category": "design",
  "description": "Server-rendered content shown until a WP Suite React interface is ready.",
  "parent": [
    "smartcloud-ai-kit/feature",
    "smartcloud-ai-kit/doc-search",
    "gatey/authenticator",
    "smartcloud-flow/form",
    "smartcloud-flow/content-root"
  ],
  "textdomain": "wpsuite",
  "supports": {
    "align": true,
    "anchor": true,
    "html": false,
    "reusable": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
